---
import type { ClinicalCase } from '../data/cases';
import { translations } from '../i18n/translations';
import { getRelativePath } from '../utils/path';

interface Props {
  caseStudy: ClinicalCase;
}

const { caseStudy } = Astro.props;
const caseVi = translations.vi.cases?.[caseStudy.id as keyof typeof translations.vi.cases] || caseStudy;
---

<div class="group border border-stone-300/80 bg-stone-100/30 hover:border-champagne-500/60 transition-all duration-500 overflow-hidden">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
    
    <!-- Image visual -->
    <div class="md:col-span-5 relative aspect-[4/3] md:aspect-auto overflow-hidden bg-stone-200">
      <img
        src={getRelativePath(caseStudy.leadImage)}
        alt={caseStudy.title}
        loading="lazy"
        class="w-full h-full object-cover img-editorial-scale"
      />
      <div data-i18n={`cases.${caseStudy.id}.discipline`} class="absolute top-4 left-4 bg-ivory-50/90 backdrop-blur-sm px-3 py-1 text-[9px] uppercase tracking-[0.2em] font-sans text-charcoal-900">
        {caseVi.discipline}
      </div>
    </div>

    <!-- Narrative & Clinical detail -->
    <div class="md:col-span-7 p-6 md:p-10 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <div data-i18n="cases.monographBadge" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
          Chuyên khảo Lâm sàng Minh họa
        </div>
        <h3 data-i18n={`cases.${caseStudy.id}.title`} class="font-serif text-2xl md:text-3xl text-charcoal-900 font-light">
          {caseVi.title}
        </h3>
        <p data-i18n={`cases.${caseStudy.id}.summary`} class="text-xs md:text-sm text-stone-600 font-sans font-light leading-relaxed">
          {caseVi.summary}
        </p>

        {caseVi.patientContext && (
          <div class="pt-2 text-xs font-sans text-stone-600 font-light italic">
            <span data-i18n={`cases.${caseStudy.id}.patientContext`}>{caseVi.patientContext}</span>
          </div>
        )}

        <div class="pt-4 border-t border-stone-200/60 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-sans">
          <div>
            <div data-i18n="cases.materialsHeader" class="text-[10px] uppercase tracking-wider text-stone-400 mb-1">Vật liệu & Phục hình</div>
            <ul class="space-y-1 text-stone-700 font-light">
              {caseStudy.materialsUsed.map(m => (
                <li>• {m}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-stone-200/60 flex items-center justify-between text-xs font-sans text-stone-500">
        <div><span data-i18n="cases.clinicianHeader">Bác sĩ:</span> <span class="text-charcoal-900">{caseStudy.clinicians.join(', ')}</span></div>
      </div>
    </div>

  </div>
</div>