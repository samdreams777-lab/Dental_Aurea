---
import { translations } from '../i18n/translations';
import { isHomePage, getRelativePath } from '../utils/path';

const pathname = new URL(Astro.request.url).pathname;
const isHome = isHomePage(pathname);
const homeUrl = getRelativePath("/");

const navKeys = [
  { key: "treatments", href: getRelativePath("/treatments") },
  { key: "specialists", href: getRelativePath("/doctors") },
  { key: "clinic", href: getRelativePath("/clinic") },
  { key: "technology", href: getRelativePath("/technology") },
  { key: "results", href: getRelativePath("/results") },
  { key: "journal", href: getRelativePath("/journal") },
];

const normPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;
const normHome = homeUrl.endsWith('/') && homeUrl.length > 1 ? homeUrl.slice(0, -1) : homeUrl;
---

<header
  id="site-header"
  data-is-home={isHome ? "true" : "false"}
  class={`w-full z-50 select-none transition-colors duration-200 ${
    isHome
      ? 'absolute top-0 left-0 bg-transparent border-b border-[#ffffff]/15 text-[#ffffff]'
      : 'relative bg-[#ffffff] border-b border-[#e5e7eb] text-[#000000]'
  }`}
>
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 h-16 md:h-20 flex items-center justify-between">
    
    <!-- Brand Wordmark (Plain geometric sans weight 600) -->
    <a href={homeUrl} class="group flex items-baseline space-x-3 transition-opacity hover:opacity-80">
      <span class={`font-plain text-xl md:text-2xl font-semibold tracking-[-0.03em] uppercase ${isHome ? 'text-[#ffffff]' : 'text-[#000000]'}`}>
        AUREA
      </span>
      <span
        id="header-tagline"
        data-i18n="nav.tagline"
        class={`hidden sm:inline-block text-[11px] uppercase tracking-wider font-normal ${isHome ? 'text-[#ffffff]/70' : 'text-[#6b7280]'}`}
      >
        {translations.vi.nav.tagline}
      </span>
    </a>

    <!-- Desktop Navigation (Plain 15px with 1px hairline underline) -->
    <nav class={`hidden lg:flex items-center space-x-8 text-[15px] font-plain ${isHome ? 'text-[#ffffff]' : 'text-[#000000]'}`}>
      {navKeys.map((item) => {
        const normHref = item.href.endsWith('/') && item.href.length > 1 ? item.href.slice(0, -1) : item.href;
        const isActive = normPath === normHref || (normHref !== normHome && normPath.startsWith(normHref));
        return (
          <a
            href={item.href}
            data-i18n={`nav.${item.key}`}
            class={`contract-nav-link ${
              isHome
                ? `!text-[#ffffff] !decoration-[#ffffff]/30 hover:!text-[#2563eb] hover:!decoration-[#2563eb] ${isActive ? '!text-[#2563eb] !decoration-[#2563eb]' : ''}`
                : `${isActive ? 'active text-[#2563eb] !decoration-[#2563eb]' : ''}`
            }`}
          >
            {translations.vi.nav[item.key as keyof typeof translations.vi.nav]}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Actions: Language Toggle + Typographic Ghost Link -->
    <div class="hidden lg:flex items-center space-x-7 text-[15px] font-plain">
      <!-- Discreet Typographic Language Switcher -->
      <div
        class={`inline-flex items-center space-x-2 text-xs uppercase tracking-wider ${isHome ? 'text-[#ffffff]/80' : 'text-[#6b7280]'}`}
        role="group"
        aria-label="Language Selector"
      >
        <button
          type="button"
          id="btn-lang-vi"
          class={`lang-select-btn transition-colors font-medium underline underline-offset-4 ${
            isHome ? 'text-[#ffffff] decoration-[#ffffff]' : 'text-[#000000] decoration-[#000000]'
          }`}
          data-lang="vi"
          aria-pressed="true"
        >
          VI
        </button>
        <span class={isHome ? 'text-[#ffffff]/40' : 'text-[#e5e7eb]'}>/</span>
        <button
          type="button"
          id="btn-lang-en"
          class={`lang-select-btn transition-colors hover:text-[#2563eb] ${
            isHome ? 'text-[#ffffff]/70' : 'text-[#6b7280]'
          }`}
          data-lang="en"
          aria-pressed="false"
        >
          EN
        </button>
      </div>

      <!-- Structural Hairline Separator -->
      <div class={`h-4 w-[1px] ${isHome ? 'bg-[#ffffff]/20' : 'bg-[#e5e7eb]'}`}></div>

      <!-- Contract Ghost CTA Link -->
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('open-consultation-modal'))"
        data-i18n="nav.consultation"
        class={`ghost-link text-[15px] ${isHome ? '!text-[#ffffff] !decoration-[#ffffff] hover:!text-[#2563eb] hover:!decoration-[#2563eb]' : ''}`}
      >
        {translations.vi.nav.consultation}
      </button>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center space-x-4 lg:hidden">
      <div class={`inline-flex items-center space-x-1.5 text-xs ${isHome ? 'text-[#ffffff]/80' : 'text-[#6b7280]'}`}>
        <button type="button" class={`lang-select-btn font-medium ${isHome ? 'text-[#ffffff]' : 'text-[#000000]'}`} data-lang="vi">VI</button>
        <span>/</span>
        <button type="button" class={`lang-select-btn ${isHome ? 'text-[#ffffff]/70' : 'text-[#6b7280]'}`} data-lang="en">EN</button>
      </div>

      <button
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        class={`p-1 focus:outline-none ${isHome ? 'text-[#ffffff]' : 'text-[#000000]'}`}
      >
        <svg class="w-6 h-6 stroke-[1.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" d="M3.75 9h16.5M3.75 15h16.5" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-menu"
    class={`hidden lg:hidden fixed inset-x-0 top-16 px-6 py-8 z-50 ${
      isHome ? 'bg-[#000000]/95 backdrop-blur-md border-b border-[#ffffff]/20 text-[#ffffff]' : 'bg-[#ffffff] border-b border-[#e5e7eb] text-[#000000]'
    }`}
  >
    <div class="flex flex-col space-y-4 text-base font-plain">
      {navKeys.map((item) => (
        <a
          href={item.href}
          data-i18n={`nav.${item.key}`}
          class={`mobile-link border-b pb-3 ${isHome ? 'border-[#ffffff]/15 text-[#ffffff] hover:text-[#2563eb]' : 'border-[#e5e7eb] text-[#000000] hover:text-[#2563eb]'}`}
        >
          {translations.vi.nav[item.key as keyof typeof translations.vi.nav]}
        </a>
      ))}
      <div class="pt-4 flex flex-col space-y-3">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-consultation-modal'))"
          data-i18n="nav.consultation"
          class={`ghost-link text-left text-base ${isHome ? '!text-[#ffffff] !decoration-[#ffffff]' : ''}`}
        >
          {translations.vi.nav.consultation}
        </button>
        <p
          data-i18n="nav.locationNote"
          class={`text-xs pt-2 ${isHome ? 'text-[#ffffff]/60' : 'text-[#6b7280]'}`}
        >
          {translations.vi.nav.locationNote}
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  import { translations, type Language } from '../i18n/translations';

  function initHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.onclick = () => menu.classList.toggle('hidden');
      const links = document.querySelectorAll('.mobile-link');
      links.forEach(l => l.addEventListener('click', () => menu.classList.add('hidden')));
    }

    function setLanguage(lang: Language) {
      localStorage.setItem('aurea_lang', lang);
      document.documentElement.lang = lang;

      document.querySelectorAll('.lang-select-btn').forEach(btn => {
        const btnLang = btn.getAttribute('data-lang');
        const isMatch = btnLang === lang;
        btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        if (isMatch) {
          btn.classList.add('font-medium', 'underline', 'underline-offset-4');
        } else {
          btn.classList.remove('font-medium', 'underline', 'underline-offset-4');
        }
      });

      const elements = document.querySelectorAll('[data-i18n]');
      elements.forEach(el => {
        const keyPath = el.getAttribute('data-i18n');
        if (!keyPath) return;

        const parts = keyPath.split('.');
        let val: any = translations[lang];
        for (const p of parts) {
          if (val && typeof val === 'object') {
            val = val[p];
          } else {
            val = null;
            break;
          }
        }

        if (typeof val === 'string') {
          if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
            (el as HTMLInputElement).placeholder = val;
          } else {
            el.textContent = val;
          }
        }
      });

      window.dispatchEvent(new CustomEvent('aurea-lang-change', { detail: { lang } }));
    }

    document.querySelectorAll('.lang-select-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const lang = (btn.getAttribute('data-lang') || 'vi') as Language;
        setLanguage(lang);
      });
    });

    const storedLang = (localStorage.getItem('aurea_lang') || 'vi') as Language;
    setLanguage(storedLang);
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>