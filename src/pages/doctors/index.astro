---
import Layout from '../../layouts/Layout.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import { doctors } from '../../data/doctors';
import { translations } from '../../i18n/translations';
---

<Layout
  title="Medical Faculty & Specialists — AUREA Private Institute"
  description="Meet the clinical leadership of AUREA: international reconstructive surgeons, master aesthetic dentists, and facial aesthetic physicians."
>
  <section class="py-24 md:py-36 bg-ivory-50 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl space-y-6">
        <div data-i18n="doctorsPage.badge" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
          {translations.vi.doctorsPage.badge}
        </div>
        <h1 data-i18n="doctorsPage.title" class="font-serif text-4xl md:text-6xl text-charcoal-900 font-light leading-[1.1]">
          {translations.vi.doctorsPage.title}
        </h1>
        <p data-i18n="doctorsPage.desc" class="text-sm md:text-base text-stone-600 font-sans font-light leading-relaxed">
          {translations.vi.doctorsPage.desc}
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-36 bg-stone-100/40 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {doctors.map((doc) => (
          <DoctorCard
            id={doc.id}
            name={doc.name}
            role={doc.role}
            specialty={doc.specialty}
            image={doc.image}
            slug={doc.slug}
            quote={doc.quote}
            scheduleLimit={doc.scheduleLimit}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-ivory-50 text-center">
    <div class="max-w-3xl mx-auto px-6 space-y-6">
      <div data-i18n="footer.disclaimer" class="text-xs text-stone-500 font-sans font-light leading-relaxed">
        {translations.vi.footer.disclaimer}
      </div>
    </div>
  </section>
</Layout>