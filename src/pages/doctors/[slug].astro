---
import Layout from '../../layouts/Layout.astro';
import { doctors, type Doctor } from '../../data/doctors';
import { translations } from '../../i18n/translations';
import { getRelativePath } from '../../utils/path';

export function getStaticPaths() {
  return doctors.map((doctor) => ({
    params: { slug: doctor.slug },
    props: { doctor },
  }));
}

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const docVi = translations.vi.doctors?.[doctor.id as keyof typeof translations.vi.doctors] || doctor;
---

<Layout
  title={`${doctor.name} — ${docVi.role}`}
  description={docVi.bio}
  image={getRelativePath(doctor.image)}
>
  <!-- Hero / Introduction -->
  <section class="py-24 md:py-36 bg-ivory-50 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Portrait -->
        <div class="lg:col-span-5 space-y-6">
          <div class="relative aspect-[4/5] overflow-hidden bg-stone-200 border border-stone-300">
            <img
              src={getRelativePath(doctor.image)}
              alt={doctor.name}
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="p-6 border border-stone-200 bg-stone-100/60 space-y-3 text-xs font-sans">
            <div data-i18n="nav.protocol" class="text-[10px] uppercase tracking-widest text-champagne-600 font-medium">Lịch làm việc</div>
            <div data-i18n={`doctors.${doctor.id}.scheduleLimit`} class="text-charcoal-900 font-medium">{docVi.scheduleLimit}</div>
          </div>
        </div>

        <!-- Biography & Philosophy -->
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-3">
            <div data-i18n="nav.specialists" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
              Chuyên gia
            </div>
            <h1 class="font-serif text-4xl md:text-6xl text-charcoal-900 font-light">
              {doctor.name}
            </h1>
            <div class="text-sm uppercase tracking-wider text-stone-500 font-sans font-medium">
              <span data-i18n={`doctors.${doctor.id}.role`}>{docVi.role}</span> · <span data-i18n={`doctors.${doctor.id}.specialty`}>{docVi.specialty}</span>
            </div>
          </div>

          <blockquote class="font-serif text-2xl md:text-3xl text-charcoal-900 font-light italic border-l-2 border-champagne-500 pl-6 py-2 leading-relaxed">
            "<span data-i18n={`doctors.${doctor.id}.quote`}>{docVi.quote}</span>"
          </blockquote>

          <div class="text-sm md:text-base text-stone-700 font-light font-sans leading-relaxed space-y-4">
            <p data-i18n={`doctors.${doctor.id}.bio`}>{docVi.bio}</p>
          </div>

          <!-- Credentials & Qualifications -->
          <div class="pt-6 border-t border-stone-200 space-y-4">
            <div data-i18n="doctorsPage.badge" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
              Bằng cấp & Chứng chỉ Chuyên môn
            </div>
            <ul class="space-y-2.5 text-xs md:text-sm text-stone-700 font-light">
              {docVi.credentials.map((cred: string) => (
                <li class="flex items-center space-x-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-champagne-500 flex-shrink-0"></span>
                  <span>{cred}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Clinical Focus & Procedures -->
          <div class="pt-6 border-t border-stone-200 space-y-4">
            <div data-i18n="nav.treatments" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
              Lĩnh vực Chuyên sâu
            </div>
            <div class="flex flex-wrap gap-2">
              {docVi.procedures.map((proc: string) => (
                <span class="px-3.5 py-1.5 bg-stone-200/70 text-charcoal-900 text-xs font-sans">
                  {proc}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-8">
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-consultation-modal'))"
              data-i18n="hero.ctaPrimary"
              class="px-8 py-4 bg-charcoal-900 text-ivory-50 text-xs uppercase tracking-[0.22em] font-sans hover:bg-champagne-600 transition-colors"
            >
              {translations.vi.hero.ctaPrimary} →
            </button>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>