---
import Layout from '../layouts/Layout.astro';
import CaseCard from '../components/CaseCard.astro';
import { clinicalCases } from '../data/cases';
import { translations } from '../i18n/translations';
---

<Layout
  title="Clinical Monograph & Results — AUREA Private Institute"
  description="Explore our conceptual archive of clinical cases in bespoke ceramic veneers, immediate zirconia implants, occlusal rehabilitation, and facial architecture."
>
  <section class="py-24 md:py-36 bg-ivory-50 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl space-y-6">
        <div data-i18n="resultsPage.badge" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
          {translations.vi.resultsPage.badge}
        </div>
        <h1 data-i18n="resultsPage.title" class="font-serif text-4xl md:text-6xl text-charcoal-900 font-light leading-[1.1]">
          {translations.vi.resultsPage.title}
        </h1>
        <p data-i18n="resultsPage.desc" class="text-sm md:text-base text-stone-600 font-sans font-light leading-relaxed">
          {translations.vi.resultsPage.desc}
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-36 bg-stone-100/40 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      {clinicalCases.map((c) => (
        <CaseCard caseStudy={c} />
      ))}
    </div>
  </section>

  <!-- Consultation Banner -->
  <section class="py-24 bg-charcoal-950 text-ivory-50 text-center">
    <div class="max-w-3xl mx-auto px-6 space-y-6">
      <div data-i18n="modal.badge" class="text-[10px] uppercase tracking-[0.25em] text-champagne-400 font-sans font-medium">
        {translations.vi.modal.badge}
      </div>
      <h2 data-i18n="modal.title" class="font-serif text-3xl md:text-5xl font-light">
        {translations.vi.modal.title}
      </h2>
      <p data-i18n="modal.subtitle" class="text-sm text-stone-400 font-sans font-light leading-relaxed">
        {translations.vi.modal.subtitle}
      </p>
      <div class="pt-4">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-consultation-modal'))"
          data-i18n="hero.ctaPrimary"
          class="px-8 py-4 bg-champagne-500 text-charcoal-950 text-xs uppercase tracking-[0.22em] font-sans hover:bg-champagne-400 transition-all duration-300"
        >
          {translations.vi.hero.ctaPrimary} →
        </button>
      </div>
    </div>
  </section>
</Layout>