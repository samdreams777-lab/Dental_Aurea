---
import Layout from '../../layouts/Layout.astro';
import { journalArticles } from '../../data/cases';
import { translations } from '../../i18n/translations';
---

<Layout
  title="The AUREA Journal — Essays on Longevity, Symmetry & Precision"
  description="Editorial insights from our medical faculty exploring the intersections of restorative dentistry, facial architecture, and biological longevity."
>
  <section class="py-24 md:py-36 bg-ivory-50 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-3xl space-y-6">
        <div data-i18n="nav.journal" class="text-[10px] uppercase tracking-[0.25em] text-champagne-600 font-sans font-medium">
          {translations.vi.nav.journal}
        </div>
        <h1 data-i18n="nav.journal" class="font-serif text-4xl md:text-6xl text-charcoal-900 font-light leading-[1.1]">
          Chuyên Khảo AUREA
        </h1>
        <p data-i18n="journal.mathematics-of-natural-harmony.excerpt" class="text-sm md:text-base text-stone-600 font-sans font-light leading-relaxed">
          {translations.vi.journal['mathematics-of-natural-harmony'].excerpt}
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-36 bg-stone-100/40 border-b border-stone-300">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {journalArticles.map((article) => {
          const artVi = translations.vi.journal?.[article.slug as keyof typeof translations.vi.journal] || article;
          return (
            <a
              href={`/journal/${article.slug}`}
              class="group flex flex-col border border-stone-300 bg-ivory-50 p-6 hover:border-champagne-500/60 transition-all duration-300"
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-stone-200 mb-6">
                <img
                  src={article.image}
                  alt={article.title}
                  loading="lazy"
                  class="w-full h-full object-cover img-editorial-scale"
                />
                <div data-i18n={`journal.${article.slug}.category`} class="absolute top-3 left-3 bg-ivory-50/90 backdrop-blur-sm px-2.5 py-0.5 text-[9px] uppercase tracking-widest text-charcoal-900">
                  {artVi.category}
                </div>
              </div>

              <div class="space-y-3 flex-grow flex flex-col justify-between">
                <div class="space-y-2">
                  <h3 data-i18n={`journal.${article.slug}.title`} class="font-serif text-xl text-charcoal-900 font-light group-hover:text-champagne-700 transition-colors leading-snug">
                    {artVi.title}
                  </h3>
                  <p data-i18n={`journal.${article.slug}.excerpt`} class="text-xs font-sans text-stone-600 font-light leading-relaxed">
                    {artVi.excerpt}
                  </p>
                </div>

                <div class="pt-4 border-t border-stone-200/60 text-[11px] text-stone-500 font-sans">
                  <span data-i18n={`journal.${article.slug}.author`}>{artVi.author}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>